# Copy these values into your shell or CI environment. Do not commit credentials.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=HealthcareOrchestratorAgent2
FOUNDRY_MODEL_NAME=gpt-4.1

# Created when Fabric IQ (OneLake Catalog) is connected to the published
# HealthcareHLSAgent Data Agent in this Foundry project.
FABRIC_IQ_CONNECTION_NAME=HealthcareHLSAgent

# Existing Azure AI Search project connection and healthcare knowledge index.
AZURE_AI_SEARCH_CONNECTION_NAME=<search-connection-name>
AZURE_AI_SEARCH_INDEX_NAME=healthcare-onelake-ks-index
